# Groq API key — leave blank in this example file.
# Put your real key only in the private .env file.
GROQ_API_KEY=

# Language and speech models
# Verify this LLM model ID against your available Groq models.
LLM_MODEL=openai/gpt-oss-120b
STT_MODEL=whisper-large-v3-turbo

# Embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
EMBEDDING_MAX_TOKENS=512

# Hybrid retrieval
TOP_K_CANDIDATES=40
BM25_TOP_K=40
RERANK_TOP_N=24
TOP_K_CONTEXT=6
RRF_K=60

# Reranking
ENABLE_RERANKING=true
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_BATCH_SIZE=8

# Query expansion
ENABLE_QUERY_EXPANSION=true

# Text chunking
CHUNK_TARGET_TOKENS=380
CHUNK_OVERLAP_TOKENS=60

# Answer generation
ANSWER_MAX_SENTENCES=4
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# API timeout and retries
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2